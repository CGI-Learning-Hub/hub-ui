{
  "name": "@cgi-learning-hub/ui",
  "version": "1.15.0-dev",
  "description": "React component library for Hub's design system, built on Material UI with custom and extended components.",
  "keywords": [
    "cgi-learning-hub",
    "react",
    "component-library",
    "mui"
  ],
  "author": "CGI Learning Hub Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CGI-Learning-Hub/hub-ui.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./tiptap": {
      "types": "./dist/tiptap/index.d.ts",
      "import": "./dist/tiptap/index.es.js",
      "require": "./dist/tiptap/index.cjs.js"
    },
    "./index.css": "./dist/ui.css",
    "./tiptap/styles.css": "./dist/tiptap/styles.css"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.css",
    "!dist/**/*.map"
  ],
  "sideEffects": false,
  "scripts": {
    "build:js": "vite build",
    "build:css": "sass src/tiptap/styles/index.scss dist/tiptap/styles.css --no-source-map",
    "build": "pnpm run build:js && pnpm run build:css",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "@mui/icons-material": "9.4.0",
    "@mui/lab": "9.0.0-beta.9",
    "@mui/system": "^9",
    "@mui/x-date-pickers": "9.12.0",
    "@mui/x-tree-view": "9.12.0",
    "@uiw/color-convert": "2.10.3",
    "@uiw/react-color-circle": "2.10.3",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "react-dropzone": "20.1.1"
  },
  "peerDependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@mui/material": "^9",
    "@tiptap/pm": "^3",
    "@tiptap/react": "^3",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "^1",
    "@reduxjs/toolkit": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0",
    "sass-embedded": "^1"
  }
}
